<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Localization key constants are intentionally documented by their key catalog, not per member. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Shared library: consumed by the Avalonia GUI, the Terminal.Gui console app and tests. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-rc.1.26425.128" />
    <PackageReference Include="Serilog" Version="4.4.1-dev-02447" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.1-dev-02312" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="JsonLocalization\" />
    <Folder Include="Models\Dto\" />
  </ItemGroup>

</Project>
