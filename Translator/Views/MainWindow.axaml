<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Afutrans.Core.ViewModels"
        xmlns:local="using:Translator"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Translator.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding AppTitle}"
        Height="700"
        Width="1100"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <!-- Design-time preview needs a parameterless view model, which the shared shell does not have;
         the real DataContext is assigned in App.axaml.cs from the DI container. -->

    <!-- Static chrome: header and footer live OUTSIDE the ContentControl, so navigating
         (the ContentControl below) swaps only the page, never the header or the footer. -->
    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top" Padding="16,12" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding AppTitle}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <!-- Navigation items come from the shared ShellViewModel (route table driven). -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding NavigationItems}" Margin="24,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItemViewModel">
                            <Button Content="{Binding Title}"
                                    Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).NavigateCommand}"
                                    CommandParameter="{Binding RouteKey}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Column="2"
                           Text="{Binding CurrentPageTitle}"
                           FontSize="16"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="16,8" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
            <TextBlock Text="{Binding FooterText}" TextWrapping="Wrap" Opacity="0.8" />
        </Border>

        <!-- The ONLY part that navigation replaces. -->
        <ContentControl Content="{Binding CurrentViewModel}" />

    </DockPanel>
</Window>
